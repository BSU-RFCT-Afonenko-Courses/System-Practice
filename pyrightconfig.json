{
  "include": ["."],
  "exclude": [
    "**/_extensions/**",
    "**/vendor/**",
    ".platform",
    ".ci",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.quarto/**",
    "**/_generated/**",
    "**/_freeze/**",
    "**/_output/**",
    "**/_site*/**",
    "docs/superpowers"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.12",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["tools", "tests"]
    }
  ]
}
